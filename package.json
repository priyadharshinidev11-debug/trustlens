{
  "name": "trustlens",
  "version": "1.0.0",
  "description": "TrustLens: check links, messages, UPI IDs and QR codes before you trust them.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "migrate": "node --disable-warning=ExperimentalWarning server/db/migrate.js",
    "seed": "node --disable-warning=ExperimentalWarning server/db/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  },
  "optionalDependencies": {
    "pg": "^8.13.0"
  }
}
