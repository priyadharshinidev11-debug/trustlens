# --- Server ---
PORT=3000
NODE_ENV=development
# Required in production. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Set to 1 if you run behind a reverse proxy (Nginx, Render, Railway...) so client IPs are read from X-Forwarded-For
TRUST_PROXY=0

# --- Database ---
# Leave empty to use a local SQLite file (data/trustlens.db). Set to use PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/trustlens
DATABASE_URL=
SQLITE_PATH=

# --- First admin account (created on startup if it does not exist) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Optional integrations ---
# Google Safe Browsing API key (enables a live malicious-URL lookup)
GOOGLE_SAFE_BROWSING_KEY=

# Community reports needed (confirmations minus disputes) before a pending report starts blocking
BLOCKLIST_THRESHOLD=3
